# Production configuration for npm run build (Vite production mode).
# Copy to .env.production.local or configure your hosting build environment.
# Priority, highest first: shell/hosting variables, .env.production.local,
# .env.production, .env.local, .env. Rebuild after changing these values.
# VITE_ values are public browser configuration: never put secrets here.

# Confirmed HTTPS production origin. Required with verified=true for SEO publication.
VITE_SITE_URL=
# Set exactly true only after the business contact details have been verified.
# false keeps the contact warning and disables SEO publication.
VITE_BUSINESS_DETAILS_VERIFIED=false

# Optional event-only analytics bridge. Default off; no provider/script is bundled.
# A reviewed privacy-conscious provider must subscribe to evergreen:analytics.
# Events contain only event name, known route path and optional enquiry channel.
VITE_ANALYTICS_ENABLED=false

# Confirmed WhatsApp number: 10-digit Indian mobile number, optionally prefixed by 91.
# Digits only; defaults to the confirmed company number when blank.
VITE_CONTACT_WHATSAPP=916300182036

# Existing same-origin backend paths beginning with / (not // or absolute URLs).
# Leave blank until services exist; the forms then offer direct contact instead.
# Solar Fit POST: multipart FormData with JSON "details" and optional "photos".
# Up to 3 JPG/PNG/WebP photos, 3,000,000 bytes combined; full request cap 4,000,000 bytes.
# Contact POST: application/json. Both must return successful JSON:
# { "received": true, "id": "<receipt identifier>" }
VITE_ENQUIRY_ENDPOINT=/.netlify/functions/solar-fit
VITE_CONTACT_ENDPOINT=/.netlify/functions/contact

# SERVER ONLY: set in Netlify environment variables with Functions scope.
# Never prefix these secrets/settings with VITE_. No real credentials belong here.
RESEND_API_KEY=
# Bare sender email address on your Resend-verified domain (not the recipient Gmail).
ENQUIRY_EMAIL_FROM=
# Exact site origin including https://, no trailing slash. Local Netlify Dev may use
# http://localhost with its actual port. Only this origin can submit enquiries.
ENQUIRY_ALLOWED_ORIGIN=

# Newsletter requires BOTH settings to enable subscriptions.
# Endpoint: same-origin path; accepts JSON { email, consent } and returns
# successful JSON { "subscribed": true }; HTTP 409 means already subscribed.
VITE_NEWSLETTER_ENDPOINT=
# Working public unsubscribe URL supplied by the newsletter service.
VITE_NEWSLETTER_UNSUBSCRIBE_URL=
